# Adresse publique du site (sans / final). Sert aux URL canoniques, au sitemap, au RSS et aux partages.
NEXT_PUBLIC_SITE_URL=https://www.passe-d.net

# Base PostgreSQL (Supabase : Project Settings > Database > Connection string > "Transaction pooler", port 6543).
# Sans cette variable, une base embarquée de développement est utilisée (à ne pas utiliser en production).
DATABASE_URL=postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:6543/postgres
# Facultatif : connexion directe (port 5432) pour appliquer les migrations au build, si le pooler pose problème.
# DATABASE_MIGRATION_URL=postgresql://postgres:MOT_DE_PASSE@db.xxxx.supabase.co:5432/postgres

# Stockage des photos et vidéos (Supabase : Project Settings > API). La clé service_role reste côté serveur.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# SUPABASE_STORAGE_BUCKET=media

# Code demandé une seule fois pour créer le premier compte administrateur sur /admin/setup.
ADMIN_SETUP_TOKEN=choisissez-une-longue-phrase-secrete
